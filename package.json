{
  "name": "switchboardbridge",
  "version": "3.1.1",
  "private": true,
  "description": "A simple Nextcloud app to enable calling the CLARIN Language Resource Switchboard directly from within the Nextcloud files app",
  "homepage": "https://github.com/clarin-eric/B2Drop2LRSwitchboard",
  "repository": {
    "type": "git",
    "url": "https://github.com/clarin-eric/B2Drop2LRSwitchboard"
  },
  "license": "AGPLv3",
  "author": "André Moreira <andre@clarin.eu>",
  "scripts": {
    "build": "NODE_ENV=production webpack --progress --config webpack.js",
    "dev": "NODE_ENV=development webpack --progress --config webpack.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "watch": "NODE_ENV=development webpack --progress --watch --config webpack.js"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "overrides": {
    "eslint": "10.9.1",
    "fast-xml-parser": "5.11.1"
  },
  "dependencies": {
    "@nextcloud/axios": "^2.6.0",
    "@nextcloud/event-bus": "^3.3.3",
    "@nextcloud/files": "^4.0.0",
    "@nextcloud/files-v3": "npm:@nextcloud/files@^3.12.2",
    "@nextcloud/initial-state": "^3.0.0",
    "@nextcloud/router": "^3.1.0",
    "@nextcloud/vue": "^9.11.0",
    "vue": "^3.5.42",
    "vue-material-design-icons": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@nextcloud/browserslist-config": "^3.1.2",
    "@nextcloud/eslint-config": "^9.0.1",
    "@nextcloud/webpack-vue-config": "^7.0.4",
    "eslint-import-resolver-custom-alias": "^1.3.2",
    "webpack-shell-plugin-next": "^2.3.3"
  },
  "engines": {
    "node": "^23.0.0",
    "npm": "^11.2.0"
  }
}
